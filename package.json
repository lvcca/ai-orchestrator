{
  "name": "ai-orchestrator",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.ts",
  "repository": { "type": "git", "url": "git+https://github.com/lvcca/ai-orchestrator.git"},
  "scripts": {
    "build": "tsc && npm run copy-prompts",
    "start": "npx tsx src/main.ts",
    "dev": "nodemon dist/main.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "pipeline": "npm run format && npm run build",
    "copy-prompts": "mkdir -p /app/dist/prompts && cp -r /app/src/prompts/* /app/dist/prompts/"
  },
  "keywords": [],
  "author": "Mason L. Palma",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemon": "^3.1.14",
    "npm-run": "^5.0.1",
    "redis": "^6.0.0",
    "typescript": "^6.0.3",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.0"
  }
}
